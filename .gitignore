# =============================================================
# .gitignore — Producto 3 (FullStackAttack)
# =============================================================

# --- Dependencias Node ---
# CRÍTICO: node_modules NUNCA debe subirse al repo.
# Pesa cientos de MB y se regenera con `npm install`.
node_modules/

# --- Variables de entorno ---
# Contiene secretos (JWT, URI Mongo Atlas, contraseñas).
# Solo se sube la plantilla .env.example.
.env
.env.local
.env.*.local

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Carpetas de build y cache ---
dist/
build/
.cache/
.parcel-cache/
coverage/

# --- Archivos del sistema ---
# Windows
Thumbs.db
Desktop.ini
ehthumbs.db

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Linux
*~

# --- IDEs y editores ---
# VS Code (dejamos solo algunos archivos compartibles)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# IntelliJ / WebStorm
.idea/
*.iml

# Sublime
*.sublime-project
*.sublime-workspace

# --- Datos locales de MongoDB en Docker ---
# Los volúmenes del contenedor no deben ir a Git.
mongo-data/
mongodb-data/
data/db/

# --- Backups y temporales ---
*.bak
*.tmp
*.swp
*.swo

# --- Archivos propios del consultor/equipo que no queremos versionar ---
TODO.md
NOTAS.md